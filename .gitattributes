# Every published file is hash-bound. Preserve bytes on every platform;
# the explicit LF rules below apply to the named maintained source files.
* -text whitespace=cr-at-eol

# Preserve exact bytes for artifacts referenced by SHA-256 manifests.
# In particular, Windows core.autocrlf must not invalidate evidence on checkout.
/.gitattributes text eol=lf
/.gitignore text eol=lf
data/site_inputs/factory_sites.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/site_inputs/factory_sites.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/site_inputs/factory_boundaries.geojson -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
apps/factory-pilot/dist/pilot-data.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
apps/factory-pilot/dist/research-data.js -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
apps/factory-pilot/dist/downloads/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/research_phase1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
apps/factory-pilot/dist/study/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Matplotlib SVG path data includes trailing separators; preserve generated bytes.
apps/factory-pilot/dist/study/figures/*.svg -text -whitespace
# Probability-study evidence and code hashes must survive Windows checkout.
data/probability_phase1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/probability_phase2/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/probability_protocol_v1.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
src/probability_*.py text eol=lf
tools/probability_*.py text eol=lf
tests/test_probability_*.py text eol=lf
docs/PROBABILITY_*.md text eol=lf
# Verbatim user plan includes intentional Markdown hard line breaks.
docs/PROBABILITY_USER_REVIEW_PLAN_20261105.md -whitespace

# Phase 3 persisted model text, checkpoints and byte manifests.
data/probability_phase3/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/probability_phase3_run.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
figures/probability_phase3/** -text -whitespace

# Phase 4 immutable seals and evidence retain the bytes actually evaluated.
data/probability_phase4/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/probability_phase4_freeze.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
figures/probability_phase4/** -text -whitespace

# Phase 5 local evidence and reports preserve their recorded byte hashes.
data/probability_phase5/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
configs/probability_phase5*.json text eol=lf
reports/probability_phase5/** -text -whitespace
tools/probability_phase5_verify_ui.cjs text eol=lf
/README.md text eol=lf
publication/** -text
/DATA_LICENSES.md text eol=lf
/LICENSE.md text eol=lf
/requirements-reproduce.txt text eol=lf
tools/verify_publication.py text eol=lf
configs/reproduce_2018_2024_bjt.yaml text eol=lf
